generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name_en  String
  name_ar  String
  email    String @unique
  password String
  role     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}